 /// desktop.
 const String installedCoresPreferenceKey = 'installed_libretro_cores';
 
+/// Nix owns these binaries and optional system assets. An unset environment
+/// variable keeps the normal download-based installation behavior.
+final Map<String, _ManagedCore>? _managedCores = _readManagedCores();
+
+Map<String, _ManagedCore>? _readManagedCores() {
+  final manifest = Platform.environment['MOONFIN_LIBRETRO_MANIFEST'];
+  if (manifest == null) return null;
+  final document = jsonDecode(File(manifest).readAsStringSync());
+  if (document is! Map<String, dynamic> ||
+      document['cores'] is! Map<String, dynamic>) {
+    throw const FormatException('Invalid Moonfin libretro core manifest');
+  }
+  final entries = document['cores'] as Map<String, dynamic>;
+  return Map<String, _ManagedCore>.unmodifiable({
+    for (final entry in entries.entries)
+      entry.key: _ManagedCore.fromJson(entry.value),
+  });
+}
+
+class _ManagedCore {
+  _ManagedCore.fromJson(Object? value)
+      : path = (value as Map<String, dynamic>)['path'] as String,
+        systemDirectory =
+            (value as Map<String, dynamic>)['systemDirectory'] as String?;
+
+  final String path;
+  final String? systemDirectory;
+}
+
+bool get usesNixCoreManifest => _managedCores != null;
+
+bool managedCoreExists(String coreId) {
+  final path = _managedCores?[coreId]?.path;
+  return path != null && File(path).existsSync();
+}
+
+/// Only existing managed binaries count as installed; downloaded remnants
+/// must never become a fallback when a Nix manifest is present.
+Set<String> get managedCoreIds => {
+  for (final id in _managedCores?.keys ?? const <String>[])
+    if (managedCoreExists(id)) id,
+};
+
+/// A core-specific asset root; all other cores use writable user BIOS storage.
+Future<Directory> systemDirectoryForCore(String coreId) async {
+  final root = _managedCores?[coreId]?.systemDirectory;
+  return root == null ? GameStorage.systemDir() : Directory(root);
+}
